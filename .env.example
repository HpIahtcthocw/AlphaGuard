# Optional override for the local SQLite ledger.
PIO_DB_PATH=./data/pio.db

# Market-data routing. Unconfigured providers fall back to imported snapshot
# prices and are explicitly marked non-real-time.
PIO_MARKET_DATA_ROUTES=US=alpaca,CN=tushare
PIO_QUOTE_CACHE_TTL_SECONDS=3

# Alpaca official US equity Market Data API (IEX is the common free feed).
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
ALPACA_MARKET_DATA_FEED=iex

# TuShare Pro real-time A-share API. The account must have rt_k permission.
TUSHARE_TOKEN=

# Execution stays local unless explicitly changed. alpaca-paper submits to a
# real paper-broker account. alpaca-live additionally requires the exact live
# unlock phrase below and still requires per-order human confirmation.
PIO_EXECUTION_ADAPTER=local-paper
PIO_LIVE_TRADING_UNLOCK=
# Required exact value for live mode: I_ACCEPT_REAL_MONEY_RISK

# Optional GOAI AlphaGuard planner. Leave the key blank to run the transparent
# deterministic fallback; the UI will never claim Qwen was called in that mode.
DASHSCOPE_API_KEY=
DASHSCOPE_MODEL=qwen-plus
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
